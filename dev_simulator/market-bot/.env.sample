HTTP_HOST=0.0.0.0
HTTP_PORT=18103
# Book / health / maintenance (always direct Core Engine).
CORE_ENGINE_URL=http://127.0.0.1:18200
# Place orders via Gateway → Client Center → Core Engine (Session).
# Empty GATEWAY_URL = legacy direct POST {CORE_ENGINE_URL}/v1/orders.
GATEWAY_URL=http://127.0.0.1:8080
BOT_USERNAME=demo_user
BOT_PASSWORD=demo
# Seed game_accounts.id for demo_user (database/seed/01_demo_data.sql)
GAME_ACCOUNT_ID=1
# Comma list; empty = all listed pairs from GET /v1/engine
SYMBOLS=
# Tick interval + random extra delay (ms)
POLL_INTERVAL_MS=800
JITTER_MS=1200
# Quantity range for bot orders
MIN_QTY=1
MAX_QTY=3
# Mid used when book + trades are empty
DEFAULT_PRICE=50000
# Action weights (must sum to 100)
TAKE_PARTIAL_PCT=40
TAKE_FULL_PCT=25
MAKE_PCT=25
# Remaining % is idle
# Legacy direct-engine account_id (only when GATEWAY_URL empty)
ACCOUNT_ID=market_bot
END_USER_ID=9001
RUST_LOG=info
