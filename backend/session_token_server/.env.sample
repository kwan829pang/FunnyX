HTTP_HOST=0.0.0.0
HTTP_PORT=8082
SERVICE_NAME=funnyx-session-token-server
PUBLIC_BASE_URL=http://127.0.0.1:8082
# memory | redis
SESSION_STORE=memory
REDIS_URL=redis://127.0.0.1:6379
TOKEN_TTL_SECS=3600
REFRESH_TTL_SECS=604800
OAUTH_CODE_TTL_SECS=300
INTERNAL_API_KEY=demo-internal-key
# Where Partner OAuth callback sends the browser after issuing a platform session
CLIENT_WEB_REDIRECT=http://127.0.0.1:3000/oauth/callback

# Platform OAuth IdP (Partners login platform-registered users)
PLATFORM_OAUTH_CLIENT_ID=platform_partner_client
PLATFORM_OAUTH_CLIENT_SECRET=platform_partner_secret
PLATFORM_OAUTH_REDIRECT_URIS=http://127.0.0.1:18102/oauth/callback,http://127.0.0.1:3000/oauth/callback

# Partner A (company-a-server) — Client Web Path B
PARTNER_A_ID=partner_2001
PARTNER_A_OAUTH_AUTHORIZE=http://127.0.0.1:18102/oauth/authorize
PARTNER_A_OAUTH_TOKEN=http://127.0.0.1:18102/oauth/token
PARTNER_A_OAUTH_USERINFO=http://127.0.0.1:18102/oauth/userinfo
PARTNER_A_CLIENT_ID=company_a_client
PARTNER_A_CLIENT_SECRET=company_a_secret
PARTNER_A_REDIRECT_URI=http://127.0.0.1:8082/v1/client/oauth/partner/callback

RUST_LOG=info
