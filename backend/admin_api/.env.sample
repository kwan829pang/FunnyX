HTTP_HOST=0.0.0.0
HTTP_PORT=18300
SERVICE_NAME=funnyx-admin-api
PUBLIC_BASE_URL=http://127.0.0.1:18300

# Session Token Server issues admin session tokens after Admin API verifies credentials
SESSION_TOKEN_SERVER_URL=http://127.0.0.1:8082
SESSION_INTERNAL_API_KEY=demo-internal-key
INTERNAL_API_KEY=demo-internal-key
CONFIG_SERVER_URL=http://127.0.0.1:8090

# Core Engine activate on market approve (fallback if Config registry empty)
CORE_ENGINE_URL=http://127.0.0.1:18200
CORE_ENGINE_ADMIN_KEY=demo-admin-key

# POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/funnyx
RUST_LOG=info
