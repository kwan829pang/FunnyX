HTTP_HOST=0.0.0.0
HTTP_PORT=8080
SOCKET_HOST=0.0.0.0
SOCKET_PORT=9000
SERVICE_NAME=funnyx-gateway
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Upstream fallbacks when Config Server registry is empty
CLIENT_CENTER_URL=http://127.0.0.1:8083
ADMIN_API_URL=http://127.0.0.1:18300
MESSAGE_CENTER_URL=http://127.0.0.1:8085
SESSION_TOKEN_SERVER_URL=http://127.0.0.1:8082
SESSION_INTERNAL_API_KEY=demo-internal-key
INTERNAL_API_KEY=demo-internal-key
CONFIG_SERVER_URL=http://127.0.0.1:8090

# Registry snapshot poll interval
REGISTRY_REFRESH_MS=5000
HTTP_TIMEOUT_MS=15000
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=30000
RUST_LOG=info
