ADMIN_API_KEY=demo-admin-key
HTTP_HOST=0.0.0.0
HTTP_PORT=18200
ENGINE_ID=core-engine-usdt-1
# One engine = one quote asset; pairs must share this quote (max 10).
# Default USDT shard. For FunnyX demo market DEMO_COIN/PLT (seed 01_demo_data) use:
#   QUOTE_ASSET=PLT
#   BOOTSTRAP_PAIRS=DEMO_COIN/PLT
QUOTE_ASSET=USDT
BOOTSTRAP_PAIRS=BTC/USDT,ETH/USDT
# Local dir for maintenance snapshots (pairs, pools, resting orders, trades).
DATA_DIR=./data
# Periodic checkpoint while Running (seconds).
SNAPSHOT_INTERVAL_SECS=30
# Message Center or local message-queue simulator
# Real Message Center: 8085; dev_simulator message-queue: 18101
MESSAGE_CENTER_URL=http://127.0.0.1:8085
# Partner server group notice callback (e.g. company-a-server)
PARTNER_NOTICE_URL=http://127.0.0.1:18102/api/callback
RUST_LOG=info
