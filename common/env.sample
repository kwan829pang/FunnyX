# Sample env keys for FunnyX services (aligned with funnyx-config)
# Connection hosts use user@ip form first; per-service dedicated stores are not required in early development.
SERVICE_NAME=funnyx-service
RUNTIME_MODE=development
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
SOCKET_PORT=9000
REDIS_URL=redis://xxx@xxx.xxx.xxx.xxx:6379
POSTGRES_URL=postgres://xxx:xxx@xxx.xxx.xxx.xxx:5432/funnyx
MONGO_URL=mongodb://xxx@xxx.xxx.xxx.xxx:27017
HEARTBEAT_INTERVAL_MS=5000
SOCKET_TIMEOUT_MS=30000
HTTP_TIMEOUT_MS=15000
WHITELIST_PATH=config/whitelist.sample.json
# Required when signing is enabled; no default
# SIGNING_SECRET=

# Local simulators (dev_simulator/) — IP placeholders for early phase
PAYMENT_GATE_URL=http://xxx@xxx.xxx.xxx.xxx:18100
MESSAGE_QUEUE_URL=http://xxx@xxx.xxx.xxx.xxx:18101
COMPANY_A_SERVER_URL=http://xxx@xxx.xxx.xxx.xxx:18102
COMPANY_A_API_KEY=demo-api-key
COMPANY_A_OAUTH_CLIENT_ID=company_a_client
COMPANY_A_OAUTH_CLIENT_SECRET=company_a_secret
CORE_ENGINE_URL=http://xxx@xxx.xxx.xxx.xxx:18200
CORE_ENGINE_QUOTE_ASSET=USDT
SESSION_TOKEN_SERVER_URL=http://xxx@xxx.xxx.xxx.xxx:8082
SESSION_INTERNAL_API_KEY=demo-internal-key
CLIENT_CENTER_URL=http://xxx@xxx.xxx.xxx.xxx:8083
ADMIN_API_URL=http://xxx@xxx.xxx.xxx.xxx:18300
CONFIG_SERVER_URL=http://xxx@xxx.xxx.xxx.xxx:8090
MESSAGE_CENTER_URL=http://xxx@xxx.xxx.xxx.xxx:8085
# Dev stand-in without Postgres: http://xxx@xxx.xxx.xxx.xxx:18101
PARTNER_NOTICE_URL=http://xxx@xxx.xxx.xxx.xxx:18102/v1/partner/notice
INTERNAL_API_KEY=demo-internal-key
# Private in-system heartbeat = socket PING/PONG (funnyx-heartbeat; Config probes SOCKET_PORT).
# Public third-party check = HTTP GET /health (funnyx-health; Cloudflare / Game Partners).
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=30000
HEARTBEAT_RETRY_COUNT=3
# Dev defaults: Gateway 9000, CC 9001, STS 9002, Admin 9003, Webhook 9004
SOCKET_HOST=0.0.0.0
WEBHOOK_SERVER_URL=http://xxx@xxx.xxx.xxx.xxx:8084
SHOP_PAYMENT_CALLBACK_URL=http://xxx@xxx.xxx.xxx.xxx:8084/v1/webhook/shop/payment

